# ─────────────────────────────────────────────
# TEMPLATE - Sao chép file này thành .env và điền giá trị thật
# File .env.example được phép commit lên git
# File .env KHÔNG được commit (đã có trong .gitignore)
# ─────────────────────────────────────────────

# Database
POSTGRES_DB=authdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password

# JWT - Tạo secret ngẫu nhiên, ít nhất 32 ký tự
# Gợi ý: chạy lệnh: openssl rand -base64 48
JWT_SECRET=change_me_minimum_32_characters_secret_key!!
JWT_ISSUER=test-deploy-api
JWT_AUDIENCE=test-deploy-client
JWT_EXPIRY_MINUTES=1440

# App
ASPNETCORE_ENVIRONMENT=Production
